{
  "name": "hensei-extractor",
  "version": "2.1.0",
  "description": "A Chrome extension that extracts data from Granblue Fantasy",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "wxt prepare && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && vitest run",
    "test:watch": "wxt prepare && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && vitest"
  },
  "author": "Justin Edmund",
  "license": "SEE LICENSE IN LICENSE",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "spawn-sync"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.38",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "sass": "1.98.0",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "wxt": "0.20.20"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.15.1",
    "bits-ui": "^2.17.3"
  }
}
